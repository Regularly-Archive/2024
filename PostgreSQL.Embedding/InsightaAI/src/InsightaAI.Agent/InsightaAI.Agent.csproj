<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>InsightaAI.Agent</RootNamespace>

    <!-- NuGet Package Info -->
    <PackageId>InsightaAI.Agent</PackageId>
    <Version>0.1.0</Version>
    <Authors>Insighta</Authors>
    <Description>Agent runtime with tool use loop for InsightaAI</Description>
    <PackageTags>llm;ai;agent;runtime</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="SqlSugarCore" Version="5.1.4.169" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="MetaLearning\SKILL.md" />
    <EmbeddedResource Include="Prompts\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InsightaAI.LLM.Anthropic\InsightaAI.LLM.Anthropic.csproj" />
    <ProjectReference Include="..\InsightaAI.LLM.Gemini\InsightaAI.LLM.Gemini.csproj" />
    <ProjectReference Include="..\InsightaAI.LLM.OpenAI\InsightaAI.LLM.OpenAI.csproj" />
    <ProjectReference Include="..\InsightaAI.LLM\InsightaAI.LLM.csproj" />
  </ItemGroup>

</Project>
