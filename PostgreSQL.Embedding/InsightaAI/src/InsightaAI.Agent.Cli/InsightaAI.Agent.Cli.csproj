<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>InsightaAI.Agent.Cli</RootNamespace>

    <!-- .NET Global Tool 配置 -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>insighta</ToolCommandName>
    <PackageId>InsightaAI.Agent.Cli</PackageId>
    <Version>1.0.0-alpha.2</Version>
    <Description>InsightaAI Agent CLI - Your Another AI Assistant</Description>
    <Authors>InsightaAI</Authors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InsightaAI.Agents.Subagents\InsightaAI.Agents.Subagents.csproj" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="OpenTelemetry" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InsightaAI.Agent\InsightaAI.Agent.csproj" />
    <ProjectReference Include="..\InsightaAI.LLM.OpenAI\InsightaAI.LLM.OpenAI.csproj" />
    <ProjectReference Include="..\InsightaAI.LLM.Anthropic\InsightaAI.LLM.Anthropic.csproj" />
    <ProjectReference Include="..\InsightaAI.LLM.Gemini\InsightaAI.LLM.Gemini.csproj" />
    <ProjectReference Include="..\InsightaAI.Agent.Diagnostics\InsightaAI.Agent.Diagnostics.csproj" />
  </ItemGroup>

</Project>
