{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, gen_ai_tool_name) (rate(insighta_tool_execution_duration_milliseconds_bucket{gen_ai_tool_is_allowed=\"true\"}[$__rate_interval])))", "legendFormat": "{{gen_ai_tool_name}} p50" },
        { "expr": "histogram_quantile(0.95, sum by (le, gen_ai_tool_name) (rate(insighta_tool_execution_duration_milliseconds_bucket{gen_ai_tool_is_allowed=\"true\"}[$__rate_interval])))", "legendFormat": "{{gen_ai_tool_name}} p95" }
      ],
      "title": "Tool latency by tool (p50 / p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 2,
      "options": { "showHeader": true },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "indexByName": { "gen_ai_tool_name": 0, "Value": 1 }, "renameByName": { "gen_ai_tool_name": "Tool", "Value": "Success rate" } } }
      ],
      "targets": [
        { "expr": "topk(5, (sum by (gen_ai_tool_name) (increase(insighta_tool_execution_duration_milliseconds_count{gen_ai_tool_is_allowed=\"true\",gen_ai_tool_is_error=\"false\"}[$__range])) / clamp_min(sum by (gen_ai_tool_name) (increase(insighta_tool_execution_duration_milliseconds_count{gen_ai_tool_is_allowed=\"true\"}[$__range])), 1)) and on (gen_ai_tool_name) (sum by (gen_ai_tool_name) (increase(insighta_tool_execution_duration_milliseconds_count{gen_ai_tool_is_allowed=\"true\"}[$__range])) > 0))", "format": "table", "instant": true, "legendFormat": "{{gen_ai_tool_name}}" }
      ],
      "title": "Top 5 tools by success rate",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 3,
      "options": { "showHeader": true },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "indexByName": { "gen_ai_tool_name": 0, "Value": 1 }, "renameByName": { "gen_ai_tool_name": "Tool", "Value": "Failure rate" } } }
      ],
      "targets": [
        { "expr": "topk(5, (sum by (gen_ai_tool_name) (increase(insighta_tool_execution_duration_milliseconds_count{gen_ai_tool_is_allowed=\"true\",gen_ai_tool_is_error=\"true\"}[$__range])) / clamp_min(sum by (gen_ai_tool_name) (increase(insighta_tool_execution_duration_milliseconds_count{gen_ai_tool_is_allowed=\"true\"}[$__range])), 1)) and on (gen_ai_tool_name) (sum by (gen_ai_tool_name) (increase(insighta_tool_execution_duration_milliseconds_count{gen_ai_tool_is_allowed=\"true\"}[$__range])) > 0))", "format": "table", "instant": true, "legendFormat": "{{gen_ai_tool_name}}" }
      ],
      "title": "Top 5 tools by failure rate",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "id": 4,
      "options": { "showHeader": true },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "indexByName": { "insighta_skill_name": 0, "Value": 1 }, "renameByName": { "insighta_skill_name": "Skill", "Value": "Activations" } } }
      ],
      "targets": [
        { "expr": "topk(5, sum by (insighta_skill_name) (max_over_time(insighta_skill_activation_activations_total[$__range])))", "format": "table", "instant": true, "legendFormat": "{{insighta_skill_name}}" }
      ],
      "title": "Top 5 most frequently activated skills",
      "type": "table"
    }
  ],
  "schemaVersion": 41,
  "tags": ["insighta", "opentelemetry", "tools"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "InsightaAI Tools",
  "uid": "insighta-tools",
  "version": 2
}
