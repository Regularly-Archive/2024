{
  "id": "replay-secret-redaction-edit",
  "description": "Reads a sensitive fixture, keeps its public result redacted, then edits a non-sensitive setting from the original read state.",
  "prompt": "Read the fixture configuration and change logging.level from Information to Warning without changing its credentials.",
  "fixture": "secret-redaction-edit",
  "tools": [],
  "steps": [
    {
      "toolCalls": [
        {
          "id": "call-read-config",
          "name": "read_file",
          "arguments": {
            "file_path": "${fixture}/appsettings.json"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "id": "call-edit-config",
          "name": "edit_file",
          "arguments": {
            "file_path": "${fixture}/appsettings.json",
            "old_string": "\"level\": \"Information\"",
            "new_string": "\"level\": \"Warning\""
          }
        }
      ]
    },
    {
      "text": "Updated logging level without changing credentials."
    }
  ],
  "assert": {
    "status": "completed",
    "toolCalls": ["read_file", "edit_file"],
    "finalText": "Updated logging level without changing credentials.",
    "files": [
      {
        "path": "appsettings.json",
        "contains": [
          "\"level\": \"Warning\"",
          "Password=test-password;",
          "\"apiKey\": \"test-api-key\""
        ],
        "notContains": ["\"level\": \"Information\""]
      }
    ],
    "forbiddenEventText": ["test-password", "test-api-key"],
    "requiredArtifactText": ["[REDACTED]"],
    "forbiddenArtifactText": ["test-password", "test-api-key"]
  }
}
